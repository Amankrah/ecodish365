# EcoDish365 backend environment — copy to .env and fill in real values.
# This file is committed; .env is gitignored.

# Settings module: dish_project.settings (dev) or dish_project.settings_production
DJANGO_SETTINGS_MODULE=dish_project.settings

# Required in production (settings_production.py raises if missing)
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=ecodish365.com,www.ecodish365.com
DJANGO_SECURE_SSL_REDIRECT=true

# CORS / CSRF — include scheme (https://)
CORS_ALLOWED_ORIGINS=https://ecodish365.com,https://www.ecodish365.com
CSRF_TRUSTED_ORIGINS=https://ecodish365.com,https://www.ecodish365.com

# SQLite path (production: outside repo tree)
DB_NAME=/var/www/ecodish365/backend/db.sqlite3

# Logging
DJANGO_LOG_LEVEL=WARNING
DJANGO_LOG_FILE=/var/log/ecodish365/django.log

# Cache directory (file-based, shared across workers)
CACHE_DIR=/tmp/ecodish365-cache

# Django environment: development | production.
# Default to `development` so a fresh checkout works with `python manage.py
# runserver` out of the box. Set to `production` in deploy config (systemd
# EnvironmentFile, container env, etc.) rather than this template, otherwise
# local `runserver` breaks: SECURE_SSL_REDIRECT forces https → 301, but
# runserver only speaks http; and CORS_ALLOW_ALL_ORIGINS is off in prod.
DJANGO_ENV=development

# If you set DJANGO_ENV=production while still using dish_project.settings and
# `runserver`, add localhost so the SPA can call the API (comma-separated).
# EXTRA_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- LLM provider keys (§3.4 categorizer + §3.5 LCA matcher) -----------------
# OPENAI_API_KEY is required when:
#   - The HENI categorizer escalates to the LLM (any rule-confidence factor < 0.3); see backend/heni_calculator/heni/categorization/llm_categorizer.py
#   - The LCA endpoint is called with `enable_lca_matcher=true`; see backend/api/views/environmental_views.py
#     (always required — embeddings are OpenAI-only even when LLM_PROVIDER=anthropic)
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# LCA matcher / decomposer ranking-side provider. Default "openai" with
# model gpt-4.1-mini. Set to "anthropic" (with ANTHROPIC_API_KEY below) to
# route the ranking + decomposition calls to claude-haiku-4-5 instead.
# Embeddings always use OpenAI regardless of this setting (Anthropic does
# not expose an embedding API as of 2026-05).
LLM_PROVIDER=openai

# Required if LLM_PROVIDER=anthropic (or `LLMFoodCategorizer(provider="anthropic")`).
# Get a key at https://console.anthropic.com/.
# ANTHROPIC_API_KEY=

# Optional — only needed if `LLMFoodCategorizer(provider="gemini")` is used.
# GEMINI_API_KEY=

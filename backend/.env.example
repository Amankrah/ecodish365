# EcoDish365 backend environment — copy to .env and fill in real values.
#   cp .env.example .env
# This file is committed; .env is gitignored (never commit API keys).

# Settings module: dish_project.settings (dev) or dish_project.settings_production
DJANGO_SETTINGS_MODULE=dish_project.settings

# Required in production (settings_production.py raises if missing)
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=ecodish365.com,www.ecodish365.com
DJANGO_SECURE_SSL_REDIRECT=true

# CORS / CSRF — include scheme (https://)
CORS_ALLOWED_ORIGINS=https://ecodish365.com,https://www.ecodish365.com
CSRF_TRUSTED_ORIGINS=https://ecodish365.com,https://www.ecodish365.com

# SQLite path (production: outside repo tree)
DB_NAME=/var/www/ecodish365/backend/db.sqlite3

# Logging
DJANGO_LOG_LEVEL=WARNING
DJANGO_LOG_FILE=/var/log/ecodish365/django.log

# Cache directory (file-based, shared across workers)
CACHE_DIR=/tmp/ecodish365-cache

# Django environment: development | production.
# Default to `development` so a fresh checkout works with `python manage.py
# runserver` out of the box. Set to `production` in deploy config (systemd
# EnvironmentFile, container env, etc.) rather than this template, otherwise
# local `runserver` breaks: SECURE_SSL_REDIRECT forces https → 301, but
# runserver only speaks http; and CORS_ALLOW_ALL_ORIGINS is off in prod.
DJANGO_ENV=development

# If you set DJANGO_ENV=production while still using dish_project.settings and
# `runserver`, add localhost so the SPA can call the API (comma-separated).
# EXTRA_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# LLM / AI configuration
# =============================================================================
#
# Two-provider split (see manuscript §3.8.7):
#   • Embeddings  → ALWAYS OpenAI (text-embedding-3-small). Anthropic has no
#                   embedding API. Used by CNF matcher retrieval, LCA matcher,
#                   dietary-pattern vectors.
#   • Chat + vision → LLM_PROVIDER (openai | anthropic). Used by packaged-food
#                   label extraction, ingredient decomposition, CNF AI ranking,
#                   LCA matcher ranking, recipe decomposer, 24-h recall text meals.
#
# HENI risk-factor categorizer (§3.4) uses OPENAI_API_KEY directly and does NOT
# follow LLM_PROVIDER.

# --- Always required for AI features -----------------------------------------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Chat / vision provider ----------------------------------------------------
# openai (default) | anthropic
LLM_PROVIDER=openai

# Required when LLM_PROVIDER=anthropic. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Optional model overrides --------------------------------------------------
# Leave blank to use provider defaults:
#   LLM_PROVIDER=openai     → MULTIMODAL: gpt-4o-mini,  CHAT: gpt-4.1-mini
#   LLM_PROVIDER=anthropic  → MULTIMODAL: claude-haiku-4-5, CHAT: claude-haiku-4-5
#
# MULTIMODAL_LLM_MODEL — vision label extraction:
#   /scan-product (HSR), /recall-24h “Scan packaged food” (NF + ingredients)
#
# CHAT_LLM_MODEL — text JSON (ranking, decomposition):
#   packaged-food decompose, CNF AI search ranking, LCA matcher, recipe
#   decomposer, 24-h recall text-meal decomposer
MULTIMODAL_LLM_MODEL=
CHAT_LLM_MODEL=

# --- Preset: best packaged-food quality (Opus; embeddings still OpenAI) ------
# Uncomment for infant-formula / compact bilingual labels (§3.8.7.2). ~10× cost
# vs defaults on vision calls. Requires both API keys above.
#
# LLM_PROVIDER=anthropic
# MULTIMODAL_LLM_MODEL=claude-opus-4-7
# CHAT_LLM_MODEL=claude-opus-4-7

# --- Optional: HENI categorizer only -----------------------------------------
# Only if LLMFoodCategorizer(provider="gemini") is used (not the default path).
# GEMINI_API_KEY=

# --- AI rate limits (optional; defaults shown) ---------------------------------
# Per-IP hourly cap + global monthly spend circuit breaker for:
#   /api/cnf/search/ai-enhanced/, /api/recipes/decompose/, /api/recipes/recall-24h/,
#   /api/packaged-food/extract/, /api/packaged-food/extract-combined/,
#   /api/packaged-food/decompose-ingredients/, /api/dietary-pattern/classify/
DJANGO_AI_SEARCH_PER_IP_HOURLY=50
DJANGO_AI_SEARCH_MONTHLY_BUDGET_CENTS=5000

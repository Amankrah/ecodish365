{
  "_doc": {
    "purpose": "Maps every (source, food_group_id) tuple in the multi-source CNF+WAFCT+FDC catalogue to a canonical food category, plus a cnf_equivalent_group_id used as a shim for the Rust HSR kernel and the environmental-LCA per-group lookup. Lets each scorer key its hard-coded branches on the canonical category instead of source-specific group IDs.",
    "canonical_categories": [
      "dairy",
      "eggs",
      "dairy_egg_combined",
      "fats_oils",
      "fruits",
      "vegetables",
      "legumes",
      "nuts_seeds",
      "cereals_grains",
      "breakfast_cereals",
      "beef",
      "pork",
      "lamb_veal_game",
      "poultry",
      "fish",
      "sausages_luncheon",
      "beverages",
      "alcoholic_beverages",
      "sweets",
      "babyfoods",
      "baked_products",
      "fast_foods",
      "mixed_dishes",
      "snacks",
      "soups_sauces",
      "spices_herbs",
      "unknown"
    ],
    "ranges": {
      "cnf": "1-25 (Health Canada, 23 groups, IDs 23/24 unused)",
      "wafct": "50-63 (FAO/INFOODS WAFCT 2019, 14 groups)",
      "fdc_legacy": "70-97 (FDC Foundation + SR Legacy share USDA food_category.csv)",
      "fdc_fndds": "100+ (FDC FNDDS uses WWEIA categories, allocated sequentially)"
    },
    "cnf_equivalent_group_id_doc": "When the canonical category has a clear CNF analog (e.g. 'beef' → CNF 13), this is the CNF FoodGroupID. The Rust HSR kernel and env-LCA dict both key on CNF IDs; Python translates this shim ID before delegating to them, so non-CNF foods get the same scoring path as their CNF equivalents."
  },
